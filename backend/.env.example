# ==================== 数据库配置 ====================
# 数据库文件路径（可选）
# 默认路径: backend/novelforge.db
# 可以指定绝对路径来自定义数据库位置
# NOVELFORGE_DB_PATH=/path/to/your/database.db
# 兼容旧变量：AIAUTHOR_DB_PATH

# 知识图谱 Provider（优先）
KNOWLEDGE_GRAPH_PROVIDER=sqlite

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

ASSISTANT_USE_LANGCHAIN=1

#模型调用失败时最大重试次数
MAX_TOOL_CALL_RETRIES=5

# 控制是否在启动时覆盖已有的内置数据（知识库/提示词等）
BOOTSTRAP_OVERWRITE=false
# 控制卡片schema是否覆盖，默认为false，设置为true时会重置已有的内置卡片schema
BOOTSTRAP_OVERWRITE_CARD_SCHEMAS=false

# ==================== 工作流配置 ====================
# 持久化运行记录保留时间（天），默认 7
WORKFLOW_RETENTION_PERSISTENT_DAYS=7

# ==================== Server / security boundary ====================
# NovelForge is a local, single-user application with no authentication. Keep the
# API on loopback; binding to other interfaces is unsupported (docs/security.md).
HOST=127.0.0.1
PORT=54321
# CORS: "local" = loopback origins on any port + Electron's null origin. Use an
# explicit comma-separated list or "*" only when you understand the exposure.
CORS_ORIGINS=local

# ==================== Autonomous novel jobs ====================
# Lease held by a worker per job (must exceed the longest provider call) and its heartbeat.
AUTONOMOUS_LEASE_SECONDS=300
AUTONOMOUS_HEARTBEAT_SECONDS=45
# Default hard budgets for new jobs when the request carries none (0 = unlimited).
AUTONOMOUS_DEFAULT_MAX_CALLS=0
AUTONOMOUS_DEFAULT_MAX_TOTAL_TOKENS=0
AUTONOMOUS_DEFAULT_MAX_REPAIR_CALLS=0
# Upload hardening (bytes / counts).
AUTONOMOUS_MAX_UPLOAD_BYTES=62914560
AUTONOMOUS_MAX_ZIP_ENTRIES=5000
AUTONOMOUS_MAX_EXPANDED_BYTES=419430400
AUTONOMOUS_MAX_COMPRESSION_RATIO=200
AUTONOMOUS_MAX_ENTRY_BYTES=20971520
# Test-only failpoints (never set in production), e.g. after_chapter_commit!kill
# AUTONOMOUS_FAILPOINTS=

# Kimi K3 is configured through an LLM configuration (Settings -> Models), not
# through environment variables: provider=openai_compatible, the gateway's exact
# model id, api_base=https://<gateway>/v1 and the API key. See docs/kimi-k3.md.

